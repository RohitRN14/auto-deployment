# ─────────────────────────────────────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string
# Local Docker Compose:  mongodb://mongo:27017/mern-todo
# MongoDB Atlas:         mongodb+srv://<user>:<pass>@cluster.mongodb.net/mern-todo
MONGO_URI=mongodb://mongo:27017/mern-todo

# Port the Express server listens on
PORT=5000

# Allowed frontend origin (set to your React dev server or deployed domain)
# Use * for development only – restrict in production
FRONTEND_URL=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development
