# ─────────────────────────────────────────────────────────────────────────────
# Root .env.example
# Copy to .env – NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Hub (only needed for push/CI – use GitHub Secrets in Actions) ─────
DOCKERHUB_USERNAME=youruser
DOCKERHUB_TOKEN=your_dockerhub_access_token

# ── MongoDB credentials (used by docker-compose) ──────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_please_use_strong_password
MONGO_DB=mern-todo

# ── JWT Secret (used by backend for token signing) ────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_string

# ── Application ports ─────────────────────────────────────────────────────────
BACKEND_PORT=5000
FRONTEND_PORT=80

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=production

# ── Image tag (set by CI to git SHA, or use 'latest' locally) ────────────────
IMAGE_TAG=latest
