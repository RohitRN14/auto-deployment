# ─────────────────────────────────────────────────────────────────────────────
# Frontend Environment Variables
# Copy to .env and fill in. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (used at BUILD time by Vite).
# Leave blank in dev – Vite proxy handles /api → localhost:5000
# In Docker production set this to your backend service URL:
# VITE_API_URL=http://localhost:5000
VITE_API_URL=
